# DRAYEN Atelier — Frontend Environment Configuration Template
# All client-accessible environment variables must be prefixed with VITE_

# 1. Backend API Base URL (leave empty until backend developer connects real endpoints)
# Example: https://api.drayen.in/v1
VITE_API_BASE_URL=

# 2. Merchant Payment Configuration (Authoritative UPI collection coordinates)
VITE_MERCHANT_UPI_ID=drayen.atelier@okaxis
VITE_MERCHANT_NAME=DRAYEN ATELIER
VITE_MERCHANT_QR_URL=

# 3. Logistics & Transit Configuration
# Value in integer paise (e.g., 49900 = ₹499.00)
VITE_FREE_SHIPPING_THRESHOLD_PAISE=49900
VITE_STANDARD_SHIPPING_FEE_PAISE=9900

# 4. Customer Care & Concierge
VITE_CONTACT_EMAIL=concierge@drayen.in
VITE_CONTACT_PHONE=+91 98400 12345
VITE_SUPPORT_WHATSAPP=+919840012345
